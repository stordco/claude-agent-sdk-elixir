# Docker test environment for reproducing the bug report
FROM debian:bookworm-slim

# Install required dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (required for Claude CLI)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Elixir and Erlang
RUN apt-get update && apt-get install -y \
    erlang \
    elixir \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (UID 1000)
RUN useradd -m -u 1000 app

# Switch to app user
USER app
WORKDIR /home/app

# Install hex and rebar as app user
RUN mix local.hex --force && \
    mix local.rebar --force

# Configure npm to install globally in user home directory
RUN mkdir -p /home/app/.npm-global && \
    npm config set prefix '/home/app/.npm-global'

# Add npm global bin to PATH
ENV PATH="/home/app/.npm-global/bin:${PATH}"

# Install Claude CLI in user space
RUN npm install -g @anthropic-ai/claude-code

# Verify installations
RUN which script && which node && which npm && which claude

# Copy the SDK code
COPY --chown=app:app . /home/app/claude-agent-sdk

WORKDIR /home/app/claude-agent-sdk

# Note: Credentials need to be mounted at runtime:
# docker run -v ~/.claude:/home/app/.claude ...

CMD ["/bin/bash"]
